{
    "name": "flatrate/flarum-media-privacy",
    "description": "FlatRate.wiki forum upload privacy guard for opaque FoF Upload basenames.",
    "type": "flarum-extension",
    "license": "MIT",
    "keywords": [
        "flarum",
        "privacy",
        "upload",
        "fof-upload",
        "basename"
    ],
    "homepage": "https://flatrate.wiki",
    "support": {
        "issues": "https://github.com/mrkcntrmn/flatrate-flarum-media-privacy/issues",
        "source": "https://github.com/mrkcntrmn/flatrate-flarum-media-privacy"
    },
    "require": {
        "php": "^8.1",
        "flarum/core": "^1.8.19 || ^2.0.2"
    },
    "require-dev": {
        "fof/upload": "2.0.2",
        "phpunit/phpunit": "^9.6"
    },
    "suggest": {
        "fof/upload": "FoF Upload 1.9.x or 2.0.2. Both expose IsSlugged. The listener is inert when that event is absent. Private-shared downloads are denied unless the actor is the owner or a listed participant."
    },
    "autoload": {
        "psr-4": {
            "FlatRate\\FlarumMediaPrivacy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FlatRate\\FlarumMediaPrivacy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "flarum-extension": {
            "title": "FlatRate Media Privacy",
            "category": "feature",
            "icon": {
                "name": "fas fa-user-shield",
                "backgroundColor": "#111827",
                "color": "#ffffff"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
